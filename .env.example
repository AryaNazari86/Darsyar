# Copy to /opt/darsyar/.env on the server and fill in. Never commit the real file.

# --- Django ---
DJANGO_SECRET_KEY=generate-with-openssl-rand-base64-48
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.darsyar.net,localhost,127.0.0.1
DJANGO_TRUSTED_ORIGINS=https://api.darsyar.net

# Used by WeasyPrint to fetch its own /gethtml/ page when building exam PDFs
PUBLIC_URL=https://api.darsyar.net

# --- Postgres ---
POSTGRES_DB=darsyardb
POSTGRES_USER=darsyaruser
POSTGRES_PASSWORD=
POSTGRES_HOST=host.containers.internal
POSTGRES_PORT=5432

# --- Bot tokens ---
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- Cloudflare Workers AI (grading, hints, tutor) ---
# Account ID: Cloudflare dashboard -> Workers & Pages -> right-hand sidebar.
# Token: My Profile -> API Tokens -> Create Token -> "Workers AI" template.
# The dashboard is geo-blocked from the Iranian server (403), so create these
# from a non-Iranian connection; the API itself is reachable from the server.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Free tier is 10,000 neurons/day, shared across models, resetting 00:00 UTC.
# These are all reasoning models, so a chunk of every call is the thinking
# trace. Measured neurons per grading call on a real question (2026-11), and
# how many free gradings a day that works out to:
#   @cf/qwen/qwen3-30b-a3b-fp8       ~14   ~710/day   blunt but accurate
#   @cf/google/gemma-4-26b-a4b-it    ~18   ~560/day   warmer, kinder feedback
#   @cf/zai-org/glm-4.7-flash        ~56   ~180/day   too costly, truncates
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# --- Scraper endpoints ---
# Shared secret for /scraper/ and /scrape_hamyar/. Leave empty to disable
# both endpoints entirely (they write straight into the question bank).
SCRAPER_TOKEN=
