# Copy to /opt/darsyar/.env on the server and fill in. Never commit the real file.

# --- Django ---
DJANGO_SECRET_KEY=generate-with-openssl-rand-base64-48
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.darsyar.net,localhost,127.0.0.1
DJANGO_TRUSTED_ORIGINS=https://api.darsyar.net

# Used by WeasyPrint to fetch its own /gethtml/ page when building exam PDFs
PUBLIC_URL=https://api.darsyar.net

# --- Postgres ---
POSTGRES_DB=darsyardb
POSTGRES_USER=darsyaruser
POSTGRES_PASSWORD=
POSTGRES_HOST=host.containers.internal
POSTGRES_PORT=5432

# --- Bot tokens ---
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- Scraper endpoints ---
# Shared secret for /scraper/ and /scrape_hamyar/. Leave empty to disable
# both endpoints entirely (they write straight into the question bank).
SCRAPER_TOKEN=
